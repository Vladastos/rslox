// For some reason, returning a value causes the variable to leak to the outer scope
fun outer() {
    mut innerVar = 2;
    fun inner() {
        innerVar = innerVar + 1;
        print "incrementing innerVar. new value: " + innerVar;
        print innerVar;
        return innerVar;
    };
    return inner;
};

let f = outer();

let extracted = f();

print "extracted: " + extracted;

f();
f();

print "extracted: " + extracted;