fun outer() {
    mut innerVar = 2;
    fun inner() {
        innerVar = innerVar + 1;
        print "incrementing innerVar. new value: " + innerVar;
        print innerVar;
        return innerVar;
    }
    return inner;
}

let func = outer();

let extracted = func();

print "extracted: " + extracted;

func();
func();

print "extracted: " + extracted;