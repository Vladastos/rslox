fun outer() {
    mut innerVar = 2;
    fun inner() {
        innerVar = innerVar + 1;
        print "incrementing innerVar. new value: " + innerVar;
        return innerVar;
    }
    return inner;
}

let func = outer();

let first_return_value = func();

// should be 3
print "first_return_value: " + first_return_value;

func();

func();

let second_return_value = func();

// should be 5
print "second_return_value: " + second_return_value;

// should be 3
print "first_return_value: " + first_return_value;